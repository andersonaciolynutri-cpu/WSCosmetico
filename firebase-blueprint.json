{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Store configuration and status",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "whatsapp": { "type": "string" },
        "logoUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "whatsapp", "isOpen"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "integer" }
      },
      "required": ["name", "active", "order"]
    },
    "Product": {
      "title": "Product",
      "description": "Cosmetic product",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "shortDescription": { "type": "string" },
        "fullDescription": { "type": "string" },
        "price": { "type": "number" },
        "promotionalPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "stock": { "type": "integer" },
        "volume": { "type": "string" },
        "isPromotion": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "categoryId", "price", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryType": { "type": "string", "enum": ["delivery", "pickup"] },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "number": { "type": "string" },
            "neighborhood": { "type": "string" },
            "complement": { "type": "string" },
            "reference": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "brand": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer" },
              "imageUrl": { "type": "string" },
              "observation": { "type": "string" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["pix", "card", "cash"] },
        "changeFor": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmado", "preparando", "enviado", "entregue"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "deliveryType", "items", "total", "paymentMethod", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "App user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    }
  },
  "firestore": {
    "stores": {
      "schema": "Store",
      "description": "Store configuration"
    },
    "categories": {
      "schema": "Category",
      "description": "Product categories"
    },
    "products": {
      "schema": "Product",
      "description": "Cosmetic products"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "users": {
      "schema": "User",
      "description": "User profiles"
    }
  }
}
